{
  "name": "@lat.md/embed",
  "version": "0.2.2",
  "description": "Embedding generation for lat.md — local candle/WASM MiniLM engine and OpenAI-compatible remote backends behind one interface",
  "type": "module",
  "license": "MIT",
  "author": "Yury Selivanov",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/lat.md.git",
    "directory": "packages/embed"
  },
  "keywords": [
    "embeddings",
    "candle",
    "wasm",
    "minilm",
    "lat.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup:rust": "node scripts/setup-rust.mjs",
    "build": "pnpm setup:rust && node scripts/build-wasm.mjs && tsc && node scripts/copy-wasm.mjs && node scripts/build-remote.mjs",
    "build:wasm": "pnpm setup:rust && node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "js-tiktoken": "1.0.21"
  }
}
